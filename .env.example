# Copy to .env.local. Never commit real keys.
# Use a Stripe sandbox or test-mode restricted key (rk_test_). Refuse live keys in code.

DATABASE_URL=postgresql://mahjong:mahjong@localhost:5432/mahjong_springs
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.mahjongsprings.com

# Existing Mahjong Springs property. Override per environment.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-L8C5HYQ4K6

# Stripe TEST mode only. Prefer a restricted key (rk_test_) over a secret key (sk_test_).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Snapshot destination (v1 events, including connected accounts). whsec_...
STRIPE_WEBHOOK_SECRET=
# Thin destination (Accounts v2 events). A separate whsec_... from the snapshot endpoint.
STRIPE_THIN_WEBHOOK_SECRET=

# Protects POST /api/cron/reminders/
CRON_SECRET=

# Optional WordPress source for scripts/migrate-wordpress.ts
WP_DATABASE_URL=
